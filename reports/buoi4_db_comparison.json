    "b_copurchase_2hop": {
      "description": "Tác phẩm mua/xem cùng trong 1–2 bước (ALSO_BOUGHT / ALSO_VIEWED), gộp ấn bản",
      "mongodb": {
        "median_ms": 44.18,
        "min_ms": 42.11,
        "stages_top_level": 16,
        "stages_total": 23,
        "pipeline": [
          {
            "$match": {
              "asin": "B00OV3VGP0",
              "active": true
            }
          },
          {
            "$project": {
              "seed": "$asin",
              "seed_work": "$work",
              "hop1": {
                "$concatArrays": [
                  {
                    "$setUnion": [
                      {
                        "$ifNull": [
                          "$also_buy",
                          []
                        ]
                      }
                    ]
                  },
                  {
                    "$setUnion": [
                      {
                        "$ifNull": [
                          "$also_view",
                          []
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "$unwind": "$hop1"
          },
          {
            "$match": {
              "$expr": {
                "$ne": [
                  "$hop1",
                  "$seed"
                ]
              }
            }
          },
          {
            "$lookup": {
              "from": "products",
              "localField": "hop1",
              "foreignField": "asin",
              "as": "p1"
            }
          },
          {
            "$unwind": "$p1"
          },
          {
            "$match": {
              "p1.active": true
            }
          },
          {
            "$project": {
              "seed_work": 1,
              "hop1_asin": "$p1.asin",
              "hop1_work": "$p1.work",
              "hop2_list": {
                "$concatArrays": [
                  {
                    "$setUnion": [
                      {
                        "$ifNull": [
                          "$p1.also_buy",
                          []
                        ]
                      }
                    ]
                  },
                  {
                    "$setUnion": [
                      {
                        "$ifNull": [
                          "$p1.also_view",
                          []
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "$facet": {
              "step1": [
                {
                  "$project": {
                    "candidate": "$hop1_work",
                    "seed_work": 1,
                    "hops": {
                      "$literal": 1
                    }
                  }
                }
              ],
              "step2": [
                {
                  "$unwind": "$hop2_list"
                },
                {
                  "$match": {
                    "$expr": {
                      "$ne": [
                        "$hop2_list",
                        "$hop1_asin"
                      ]
                    }
                  }
                },
                {
                  "$lookup": {
                    "from": "products",
                    "localField": "hop2_list",
                    "foreignField": "asin",
                    "as": "p2"
                  }
                },
                {
                  "$unwind": "$p2"
                },
                {
                  "$match": {
                    "p2.active": true
                  }
                },
                {
                  "$project": {
                    "candidate": "$p2.work",
                    "seed_work": 1,
                    "hops": {
                      "$literal": 2
                    }
                  }
                }
              ]
            }
          },
          {
            "$project": {
              "paths": {
                "$concatArrays": [
                  "$step1",
                  "$step2"
                ]
              }
            }
          },
          {
            "$unwind": "$paths"
          },
          {
            "$match": {
              "$expr": {
                "$ne": [
                  "$paths.candidate",
                  "$paths.seed_work"
                ]
              }
            }
          },
          {
            "$group": {
              "_id": "$paths.candidate",
              "hops": {
                "$min": "$paths.hops"
              },
              "support": {
                "$sum": 1
              }
            }
          },
          {
            "$project": {
              "_id": 0,
              "asin": "$_id",
              "hops": 1,
              "support": 1,
              "score": {
                "$divide": [
                  "$support",
                  "$hops"
                ]
              }
            }
          },
          {
            "$sort": {
              "score": -1,
              "asin": 1
            }
          },
          {
            "$limit": 10
          }
